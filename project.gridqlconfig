# GridQL's own project file, which is also the worked example of the format.
#
#   gridql config                  # what is in effect here
#   gridql run feeder_report       # a query by name, from anywhere in the tree
#
# Found by walking up from the working directory, so it applies to the whole
# repository. Paths resolve against this file, and everything here is a
# default that --db, --csv and --<param> override.

name    = "Cedar Hill example"
queries = "queries"

# The example data: two feeders out of the Cedar Hill substation. Outside a
# project, GridQL falls back to its bundled sample feeder, FDR-104, instead.
# A utility's own project points at its export or database:
#
#   csv = "gis-export"
#   db  = "grid.sqlite"
#
# and, when the network lives in the utility's Postgres, at that too, so
# 'gridql import-postgres --db grid.sqlite --force' refreshes the database:
#
#   postgres = "service=gis"
#   mapping  = "gis.toml"
csv = "examples/csv"

[params]
feeder = "FDR-1201"
