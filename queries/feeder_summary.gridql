-- A three-part walk-down of the Oakdale circuit.
-- Statements run in order, each producing its own result.

FIND feeders
SELECT mRID, name, substation, voltage
RETURN table;

FIND switches
FED BY "FDR-104"
SELECT mRID, name, state, normal_state, energized
RETURN table;

-- Anything the open lateral has left de-energised.
FIND devices
FED BY "FDR-104"
WHERE NOT energized
SELECT mRID, name, type, feeder
RETURN table
