-- A three-part walk-down of Cedar Hill 1201.
-- Statements run in order, each producing its own result.

FIND feeders
SELECT mRID, name, substation, voltage
RETURN table;

FIND switches
FED BY "FDR-1201"
SELECT mRID, name, state, normal_state, energized
RETURN table;

-- Anything the blown lateral fuse has left de-energised.
FIND devices
FED BY "FDR-1201"
WHERE NOT energized
SELECT mRID, name, type, feeder
RETURN table
